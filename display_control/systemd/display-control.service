[Unit]
Description=Smart Mirror Display Control
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/smartMirror/display_control
ExecStart=/usr/bin/python3 /home/admin/smartMirror/display_control/display_control.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
