[Unit]
Description=Monitor Control MQTT Daemon
Documentation=https://github.com/Domes711/smartMirror
After=network.target mosquitto.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/smartMirror/monitor-control
ExecStart=/usr/bin/python3 /home/admin/smartMirror/monitor-control/monitor_control.py
Restart=on-failure
RestartSec=5

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
