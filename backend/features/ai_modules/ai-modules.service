# Template — setup.sh substitutes the placeholders below and installs the
# result to /etc/systemd/system/ai-modules.service. Edit this file, not the
# generator, when the unit shape needs to change.
[Unit]
Description=Smart Mirror AI Module Builder
Documentation=https://github.com/Domes711/smartMirror
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__BACKEND_DIR__
Environment="PYTHONPATH=__BACKEND_DIR__"
Environment="PYTHONUNBUFFERED=1"
Environment="MQTT_BROKER=127.0.0.1"
Environment="MQTT_PORT=1883"
Environment="MODULE_AI_MODEL=claude-opus-4-8"
ExecStart=__PYTHON__ -m features.ai_modules.daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
