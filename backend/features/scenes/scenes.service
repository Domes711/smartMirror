# Reference copy — setup.sh generates the live unit with the real paths/user.
[Unit]
Description=Smart Mirror Scenes
Documentation=https://github.com/Domes711/smartMirror
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/smartMirror/backend
Environment="PYTHONPATH=/home/admin/smartMirror/backend"
Environment="PYTHONUNBUFFERED=1"
Environment="MQTT_BROKER=127.0.0.1"
Environment="MQTT_PORT=1883"
ExecStart=/usr/bin/python3 -m features.scenes.service
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
